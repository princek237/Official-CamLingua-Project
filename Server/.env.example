# Copy this file to .env and fill in your values
# Never commit .env to version control

APP_ENV=development
APP_URL=http://localhost/CamLingua/Server

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=camlingua
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRY_HOURS=24

# NLLB-200 Translation API (optional — falls back to mock if not set)
NLLB_API_URL=
NLLB_API_KEY=

# Mail — Gmail SMTP with App Password
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Gmail account)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=CamLingua

# CamPay Payment Gateway (https://campay.net)
# Use "DEV" for sandbox (demo.campay.net) or "PROD" for live (campay.net)
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_PERMANENT_TOKEN=
CAMPAY_ENVIRONMENT=DEV
