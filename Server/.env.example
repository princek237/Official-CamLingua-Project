# Copy this file to .env and fill in your values
# Never commit .env to version control

APP_ENV=development
APP_URL=http://localhost/CamLingua/Server

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=camlingua
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRY_HOURS=24

# NLLB-200 Translation API (optional — falls back to mock if not set)
NLLB_API_URL=
NLLB_API_KEY=

# Mail (for contact form)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@camlingua.com
MAIL_FROM_NAME=CamLingua
